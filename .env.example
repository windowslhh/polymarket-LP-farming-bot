# Polymarket LP Farming Bot - Environment Variables
# Copy this file to .env and fill in your values
#
# SECURITY:
#   1. Use a DEDICATED wallet - NEVER your main wallet
#   2. Only transfer the USDC you plan to use for LP farming
#   3. Set file permissions: chmod 600 .env
#   4. Never commit this file to git

# Your DEDICATED wallet private key (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Polymarket proxy wallet address (funder)
# If you deposited USDC through polymarket.com, your funds are in a proxy wallet.
# Find it on: polymarket.com → Profile → Settings → or check your deposit tx.
# Leave empty if you're using a direct EOA setup.
FUNDER_ADDRESS=
